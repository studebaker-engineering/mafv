{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-layout">
  <div class="product-images">
    {% assign image_sizes = '(min-width: 52rem) calc(30vw - 1.7rem), calc((100vw - 1rem) / 2)' %}
    {% for image in product.images %}
      {% if image != blank %}
        {% liquid
          assign image_loading = 'lazy'
          assign image_priority = null
          if forloop.first
            assign image_loading = 'eager'
            if section.index == 1
              assign image_priority = 'high'
            endif
          endif
          assign image_alt = image.alt | default: product.title
        %}
        {% render 'image',
          class: 'product-image',
          image: image,
          width: 2304,
          widths: '320, 480, 640, 768, 960, 1200, 1536, 1920',
          sizes: image_sizes,
          alt: image_alt,
          loading: image_loading,
          fetchpriority: image_priority
        %}
      {% endif %}
    {% endfor %}
  </div>

  <div class="product-details">
    <div class="product-info">
      <h1 class="overprint-text">{{ product.title | escape }}</h1>
      <div class="product-status-tags">
        <p class="product-price overprint-text">
          {% if product.price_varies %}
            {% assign minimum_price = product.price_min | money %}
            {% assign maximum_price = product.price_max | money %}
            {{ 'commerce.price_range' | t: minimum: minimum_price, maximum: maximum_price }}
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </p>
        {% unless product.available %}
          <p class="overprint-text product-sold-out">{{ 'commerce.sold_out' | t }}</p>
        {% endunless %}
      </div>

      <div class="rte">{{ product.description }}</div>
    </div>

    <div class="product-form">
      {% liquid
        assign current_variant = product.selected_or_first_available_variant
        assign cart_quantity = cart | item_count_for_variant: current_variant.id
        assign quantity_increment = current_variant.quantity_rule.increment | default: 1
        assign quantity_minimum = current_variant.quantity_rule.min | default: 1
        if cart_quantity > 0
          assign quantity_minimum = quantity_minimum | minus: cart_quantity | at_least: quantity_increment
        endif
        capture quantity_limit
          render 'variant-quantity-limit', variant: current_variant
        endcapture
        assign quantity_limit = quantity_limit | strip
        assign can_add = current_variant.available
        if quantity_limit != blank
          assign quantity_limit = quantity_limit | minus: cart_quantity | at_least: 0
          if quantity_limit < quantity_minimum
            assign can_add = false
          endif
        endif
      %}
      <form action="{{ product.url }}" method="get" aria-labelledby="ProductVariant-{{ section.id }}">
        <span id="ProductVariant-{{ section.id }}">{{ 'commerce.variant' | t | escape }}</span>
        {% paginate product.variants by 250 %}
          <div class="product-variants">
            {% for variant in product.variants %}
              <button
                class="product-variant"
                type="submit"
                name="variant"
                value="{{ variant.id }}"
                {% if variant == current_variant %}
                  aria-current="true"
                {% endif %}
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                <span>{{ variant.title | escape }}</span>
                <span>{{ variant.price | money }}</span>
                {% unless variant.available %}
                  <span>{{ 'commerce.sold_out' | t | escape }}</span>
                {% endunless %}
              </button>
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <input type="hidden" name="{{ paginate.page_param | escape }}" value="{{ paginate.current_page }}">
            <nav class="pagination" aria-label="{{ 'commerce.variant_pagination' | t | escape }}">
              {{ paginate | default_pagination }}
            </nav>
          {% endif %}
        {% endpaginate %}
      </form>

      {% form 'product', product %}
        {{ form.errors | default_errors }}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        <label for="ProductQuantity-{{ section.id }}">{{ 'commerce.quantity' | t }}</label>
        <input
          id="ProductQuantity-{{ section.id }}"
          type="number"
          name="quantity"
          min="{{ quantity_minimum }}"
          step="{{ quantity_increment }}"
          value="{{ quantity_minimum }}"
          {% if quantity_limit != blank %}
            max="{{ quantity_limit }}"
          {% endif %}
          aria-describedby="ProductQuantityHelp-{{ section.id }}"
          required
          {% unless can_add %}
            disabled
          {% endunless %}
        >
        <p id="ProductQuantityHelp-{{ section.id }}">
          {% if can_add %}
            {{ 'commerce.quantity_rules' | t: minimum: quantity_minimum, increment: quantity_increment }}
            {% if quantity_limit != blank %}
              {{ 'commerce.quantity_maximum_add' | t: quantity: quantity_limit }}
            {% endif %}
          {% else %}
            {% if current_variant.available %}
              {{ 'commerce.quantity_limit_reached' | t }}
            {% else %}
              {{ 'commerce.sold_out' | t }}
            {% endif %}
          {% endif %}
        </p>

        <button
          type="submit"
          name="add"
          {% unless can_add %}
            disabled
          {% endunless %}
        >
          {% if current_variant.available %}
            {{ 'commerce.add_to_cart' | t }}
          {% else %}
            {{ 'commerce.sold_out' | t }}
          {% endif %}
        </button>
        {% if can_add %}
          {{ form | payment_button }}
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  @layer sections {
    .product-layout {
      display: grid;
      gap: var(--space-2);
      align-items: start;
    }

    .product-images {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
      align-items: start;
    }

    .product-status-tags {
      display: flex;
      gap: var(--space-2);
    }

    .product-details,
    .product-info,
    .product-form {
      display: grid;
      gap: var(--space-4);
      min-width: 0;
    }

    .product-details {
      padding: var(--space-5);
    }

    .product-price,
    .product-sold-out {
      font-size: 1.25rem;
      width: fit-content;
      padding: 0 0.5rem;
      border: 2px dashed var(--color-border);
    }

    .product-price {
      /* background-color: var(--color-accent-2); */
    }

    .product-sold-out {
      background-color: var(--color-red);
    }

    .product-form form {
      display: grid;
      gap: var(--space-3);
    }
    .product-form form + form {
      padding-top: var(--space-5);
      border-top: 1px solid var(--color-border);
    }
    .product-form p {
      font-size: var(--text-small);
      color: var(--color-muted);
    }
    .product-form input[type='number'] {
      width: 6rem;
    }
    .product-form [name='add'] {
      width: 100%;
      margin-top: var(--space-3);
    }
    .product-variants {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .product-variant {
      width: min(7rem, 100%);
      aspect-ratio: 1;
      flex-direction: column;
      gap: var(--space-1);
      padding: var(--space-2);
      overflow-wrap: anywhere;
      border-color: var(--color-muted);
      border-radius: 0;
      background: var(--color-surface);
      color: var(--color-text);
    }
    .product-variant:hover:enabled,
    .product-variant[aria-current='true'] {
      border-color: var(--color-text);
      background: var(--color-accent);
      color: var(--color-text);
    }
    .product-variant[aria-current='true'] {
      box-shadow: inset 0 0 0 1px var(--color-text);
    }
    .product-variant:disabled {
      background: color-mix(in srgb, var(--color-muted) 12%, var(--color-surface));
      color: var(--color-muted);
      opacity: 1;
      cursor: not-allowed;
    }
    @media (min-width: 52rem) {
      .product-layout {
        grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
        gap: var(--space-8);
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

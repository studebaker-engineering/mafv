{% liquid
  assign menu_links = section.settings.menu.links
  if section.settings.menu == blank
    assign menu_links = linklists.footer.links | default: linklists['footer-menu'].links
  endif
  assign has_link_groups = false
  for link in menu_links
    if link.links != blank
      assign has_link_groups = true
      break
    endif
  endfor

  assign brand_words = shop.name | split: ' '
  assign longest_word = 1
  for word in brand_words
    assign longest_word = longest_word | at_least: word.size
  endfor

  assign store_name = shop.name | escape
  assign footer_topper = section.settings.footer_topper | default: images['Footer_Topper.png']
%}

<footer class="site-footer">
  <div class="footer__brand" style="--footer-word-length: {{ longest_word }}">
    <p class="footer__wordmark">{{ store_name }}</p>
    <p class="footer__copyright">
      {{ 'footer.copyright' | t: store_name: shop.name | escape }}
    </p>
  </div>

  {% if menu_links != blank %}
    <nav class="footer__links" aria-label="{{ 'accessibility.footer_navigation' | t | escape }}">
      {% if has_link_groups %}
        {% for group in menu_links %}
          <div class="footer__group">
            {% if group.links != blank %}
              <h2 class="footer__heading">{{ group.title | escape }}</h2>
              <hr class="footer__heading__divider" />
              <ul class="footer__list" role="list">
                {% for link in group.links %}
                  <li>
                    <a
                      href="{{ link.url | escape }}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <h2 class="footer__heading">
                <a
                  href="{{ group.url | escape }}"
                  {% if group.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- group.title | escape -}}
                </a>
              </h2>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <ul class="footer__list footer__list--flat" role="list">
          {% for link in menu_links %}
            <li>
              <a
                href="{{ link.url | escape }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>
  {% endif %}

  {% if section.settings.show_payment_icons %}
    {% if shop.enabled_payment_types != blank %}
      <div class="footer__payment">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</footer>

{% if footer_topper != blank %}
  {% assign topper_width = footer_topper.width | at_most: 3840 %}
  {{
    footer_topper
    | image_url: width: topper_width
    | image_tag: class: 'footer__topper', sizes: '100vw', loading: 'lazy', alt: 'Illustration of friends'
  }}
{% endif %}

{% stylesheet %}
  @layer sections {
    .footer__topper {
      display: block;
      height: auto;
      width: 100%;
      margin-top: -3rem;
    }

    .site-footer {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: top;
      gap: var(--space-6);
      padding: var(--space-6) var(--space-4);
      background-color: var(--color-background);
      text-align: left;
      font-size: var(--text-small);
      color: var(--color-text);
    }

    .footer__brand {
      container-type: inline-size;
    }

    .footer__wordmark {
      font-family: var(--font-cooper);
      font-size: clamp(1rem, calc(110cqi / var(--footer-word-length)), 6rem);
      line-height: 1;
    }

    .footer__copyright {
      font-weight: bold;
      width: fit-content;
      padding: 0 var(--space-2);
      background-color: var(--color-accent);
      border: 2px solid var(--color-border);
    }

    .footer__links {
      display: grid;
      grid-column: 2 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
      min-width: 0;
    }

    .footer__heading {
      font-size: 1.25rem;
    }

    .footer__heading__divider {
      width: 66%;
      margin-left: 0px;
      height: 2px;
      border: none;
      background-color: var(--color-border);
      margin-top: 0.5rem;
    }

    .footer__list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer__list--flat,
    .footer__payment {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .footer__links a {
      display: inline-flex;
      text-decoration: none;
      font-weight: bold;
      margin-bottom: 1rem;
    }

    .footer__links a:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-decoration-color: var(--color-border);
      text-underline-offset: 1px;
    }

    .footer__payment svg {
      width: 2.25rem;
      height: auto;
    }

    @media (max-width: 40rem) {
      .site-footer,
      .footer__links {
        grid-template-columns: minmax(0, 1fr);
      }

      .footer__wordmark {
        font-size: 5rem;
      }

      .footer__links {
        grid-column: 1 / -1;
      }

      .footer__list--flat {
        display: block;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_topper",
      "label": "t:labels.footer_topper"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}

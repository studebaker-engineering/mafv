{% liquid
  assign about_page = pages.about
  assign about_url = routes.root_url | append: '/pages/about' | replace: '//', '/'
  if about_page != blank
    assign about_url = about_page.url
  endif
%}

{% capture menu_links %}
  {% for link in section.settings.menu.links %}
    <a href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
  {% else %}
    {% render 'header-default-links', shop_url: routes.all_products_collection_url, about_url: about_url %}
  {% endfor %}
{% endcapture %}

<header class="site-header" data-site-header>
  <button
    class="header__menu-toggle"
    type="button"
    aria-label="{{ 'navigation.open_menu' | t | escape }}"
    aria-haspopup="dialog"
    aria-controls="HeaderMenu-{{ section.id }}"
    data-header-menu-toggle
    hidden
  >
    {{ 'icon-menu.svg' | inline_asset_content }}
  </button>

  <nav class="header__menu" aria-label="{{ 'accessibility.main_navigation' | t | escape }}">
    {{ menu_links }}
  </nav>

  <a class="header__brand" href="{{ routes.root_url }}">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 480
        | image_tag: widths: '120, 160, 240, 320, 480', sizes: '(max-width: 40rem) 7.5rem, 10rem', alt: shop.name
      }}
    {%- else -%}
      {{ shop.name | escape }}
    {%- endif -%}
  </a>

  <a class="header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'cart.title' | t | escape }}">
    <span>{{ 'cart.title' | t }}</span>
    {{ 'icon-cart.svg' | inline_asset_content }}
  </a>

  <dialog id="HeaderMenu-{{ section.id }}" class="header__drawer" aria-labelledby="HeaderMenuTitle-{{ section.id }}">
    <div class="header__drawer-top">
      <h2 id="HeaderMenuTitle-{{ section.id }}">{{ 'accessibility.main_navigation' | t }}</h2>
      <form method="dialog">
        <button type="submit" autofocus>{{ 'navigation.close_menu' | t }}</button>
      </form>
    </div>
    <nav class="header__drawer-links" aria-labelledby="HeaderMenuTitle-{{ section.id }}">
      {{ menu_links }}
    </nav>
  </dialog>
</header>

{% stylesheet %}
  @layer sections {
    .site-header {
      --header-logo-width: 8rem;
      --icon-stroke-width: 1.5;
      display: grid;
      grid-template-columns: minmax(0, 1fr) min(45%, var(--header-logo-width)) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-2) var(--space-3);
      padding: var(--space-1) var(--space-6);
      border-bottom: 2px solid var(--color-border);
    }

    .site-header a {
      color: inherit;
      text-decoration: none;
    }

    .site-header a:hover {
      text-decoration: underline;
    }

    .header__brand,
    .header__cart,
    .header__menu a,
    .header__drawer-links a {
      display: inline-flex;
      align-items: center;
      font-size: 1.25rem;
    }

    .header__brand {
      grid-row: 1;
      grid-column: 2;
      justify-self: center;
      justify-content: center;
      min-width: 0;
      max-width: 100%;
      text-align: center;
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: var(--weight-heading);
      letter-spacing: -0.025em;
    }

    .header__menu {
      grid-row: 1;
      grid-column: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-4);
      min-width: 0;
    }

    .header__menu-toggle,
    .header__cart {
      grid-row: 1;
      min-width: var(--control-height);
      min-height: var(--control-height);
    }

    .header__menu-toggle {
      display: none;
      grid-column: 1;
      justify-self: start;
      padding: var(--space-2);
      border-color: transparent;
      color: inherit;
      background: transparent;
    }

    .header__cart {
      grid-column: 3;
      justify-self: end;
      justify-content: center;
      gap: var(--space-2);
    }

    .header__menu-toggle svg,
    .header__cart svg {
      flex: none;
      width: 1.5rem;
      height: 1.5rem;
    }

    html:has(.header__drawer[open]),
    body:has(.header__drawer[open]) {
      overflow: hidden;
      overscroll-behavior: none;
    }

    .header__drawer {
      position: fixed;
      inset: 0 auto auto 0;
      width: var(--header-drawer-width);
      height: 100vh;
      height: 100dvh;
      max-width: 100%;
      max-height: none;
      margin: 0;
      padding: max(var(--space-4), env(safe-area-inset-top)) var(--space-4)
        max(var(--space-4), env(safe-area-inset-bottom)) max(var(--space-4), env(safe-area-inset-left));
      border: 0;
      background: var(--color-background);
      color: var(--color-text);
      overflow: auto;
      overscroll-behavior: contain;
    }

    .header__drawer:not([open]) {
      display: none;
    }

    .header__drawer[open] {
      animation: header-drawer-enter var(--transition-duration) ease-out;
    }

    @keyframes header-drawer-enter {
      from {
        transform: translateX(-100%);
      }
    }

    .header__drawer::backdrop {
      background: rgb(0 0 0 / 45%);
    }

    .header__drawer-top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-border);
    }

    .header__drawer-links {
      display: grid;
      justify-items: start;
      padding-top: var(--space-3);
    }

    @media (max-width: 40rem) {
      .site-header {
        --header-logo-width: 20rem;
      }

      .header__cart span {
        display: none;
      }

      .header__menu {
        grid-row: 2;
        grid-column: 1 / -1;
      }

      [data-menu-ready] .header__menu {
        display: none;
      }

      [data-menu-ready] .header__menu-toggle {
        display: inline-flex;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}

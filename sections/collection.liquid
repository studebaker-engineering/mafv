{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<section class="collection-section">
  <div class="collection-title__container">
    <h1 class="collection-title">{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}
      <div class="rte">{{ collection.description }}</div>
    {% endif %}
  </div>

  <div class="collection-products">
    {% assign image_sizes = '(width > 40rem) calc((100vw - 2rem - clamp(3rem, 9vw, 6rem)) / 4), calc((100vw - 2rem - clamp(1rem, 3vw, 2rem)) / 2)' %}
    {% paginate collection.products by 20 %}
      {% for product in collection.products %}
        <article class="collection-product">
          {% if product.featured_image %}
            {% liquid
              assign image_loading = 'lazy'
              if forloop.index <= 4
                assign image_loading = 'eager'
              endif
            %}
            <a class="collection-product__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% render 'image',
                class: 'collection-product__image',
                image: product.featured_image,
                width: 1536,
                widths: '240, 320, 400, 480, 640, 768, 960, 1200',
                sizes: image_sizes,
                crop: 'center',
                alt: product.featured_image.alt,
                loading: image_loading
              %}
            </a>
          {% else %}
            <div class="collection-product__media" aria-hidden="true"></div>
          {% endif %}
          <div class="collection-product__content">
            <h2>
              <a href="{{ product.url }}" class="collection-product__title">{{ product.title | escape }}</a>
            </h2>
            <p>
              {{ 'commerce.price' | t }}:
              {% if product.price_varies %}
                {% assign minimum_price = product.price_min | money %}
                {% assign maximum_price = product.price_max | money %}
                {{ 'commerce.price_range' | t: minimum: minimum_price, maximum: maximum_price }}
              {% else %}
                {{ product.price | money }}
              {% endif %}
            </p>
            {% unless product.available %}
              <p>{{ 'commerce.sold_out' | t }}</p>
            {% endunless %}
          </div>
        </article>
      {% else %}
        <p>{{ 'collections.empty' | t }}</p>
      {% endfor %}

      {% if paginate.pages > 1 %}
        <nav aria-label="{{ 'collections.pagination' | t }}">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  @layer sections {
    .collection-title__container {
      padding: var(--space-1) var(--space-6);
      border-bottom: 2px solid var(--color-border);
      height: 4rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      /* background-color: var(--color-accent); */
    }

    .collection-title {
      font-size: 1.25rem;
      font-family: var(--font-brush);
      line-height: 0;
    }

    .collection-products {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: hidden;
      padding: 2rem;
      background-color: var(--color-accent);
      border-bottom: 2px solid var(--color-border);
    }

    .collection-product__media {
      display: block;
      aspect-ratio: 1;
    }

    .collection-products > nav,
    .collection-products > p {
      grid-column: 1 / -1;
    }

    .collection-product {
      position: relative;
      display: grid;
      grid-template-rows: auto 1fr;
      border-block-end: 2px solid var(--color-border);
      padding: 0.5rem 2rem 0rem;
      background-color: var(--color-background);
    }

    .collection-product::after {
      content: '';
      position: absolute;
      inset: 0;
      border-inline-end: 2px solid var(--color-border);
      pointer-events: none;
    }

    @media (width > 40rem) {
      .collection-product:nth-child(-n + 3)::after {
        border-block-start: 2px solid var(--color-border);
      }

      .collection-product:nth-child(3n)::after {
        border-inline-end: 2px solid var(--color-border);
      }

      .collection-product:nth-child(3n + 1)::after {
        border-inline-start: 2px solid var(--color-border);
      }
    }

    @media (max-width: 40rem) {
      .collection-products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        padding: 1rem;
      }

      .collection-product:nth-child(-n + 2)::after {
        border-block-start: 2px solid var(--color-border);
      }

      .collection-product:nth-child(2n + 1)::after {
        border-inline-start: 2px solid var(--color-border);
      }

      .collection-product:nth-child(2n)::after {
        border-inline-end: 2px solid var(--color-border);
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}

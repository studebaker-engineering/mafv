{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<section class="collection-section print-grain">
  <header class="collection-header">
    <h1 class="collection-title overprint-text">{{ collection.title | escape }}</h1>
  </header>

  {% if collection.description != blank %}
    <div class="collection-description rte">{{ collection.description }}</div>
  {% endif %}

  <div class="collection-products">
    {% assign image_sizes = '(min-width: 64rem) calc((100vw - 4.5rem) / 3), (min-width: 24rem) calc((100vw - 1.5rem) / 2), calc(100vw - 0.5rem)' %}
    {% paginate collection.products by 20 %}
      {% for product in collection.products %}
        <article class="collection-product">
          {% if product.featured_image %}
            {% liquid
              assign image_loading = 'lazy'
              if forloop.index <= 4
                assign image_loading = 'eager'
              endif
            %}
            <a class="collection-product__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% render 'image',
                class: 'collection-product__image',
                image: product.featured_image,
                width: 1536,
                widths: '240, 320, 400, 480, 640, 768, 960, 1200',
                sizes: image_sizes,
                crop: 'center',
                alt: product.featured_image.alt,
                loading: image_loading
              %}
            </a>
          {% else %}
            <div class="collection-product__media" aria-hidden="true"></div>
          {% endif %}
          <div class="collection-product__content">
            <h2>
              <a href="{{ product.url }}" class="collection-product__title font-helvetica overprint-text">
                {{- product.title | escape -}}
              </a>
            </h2>
            <p>
              {% comment %} {{ 'commerce.price' | t }}: {% endcomment %}
              {% if product.price_varies %}
                {% assign minimum_price = product.price_min | money %}
                {% assign maximum_price = product.price_max | money %}
                {{ 'commerce.price_range' | t: minimum: minimum_price, maximum: maximum_price }}
              {% else %}
                {{ product.price | money }}
              {% endif %}
            </p>
            {% unless product.available %}
              <p class="collection-product__status">{{ 'commerce.sold_out' | t }}</p>
            {% endunless %}
          </div>
        </article>
      {% else %}
        <p class="collection-products__empty">{{ 'collections.empty' | t }}</p>
      {% endfor %}

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="{{ 'collections.pagination' | t | escape }}">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  @layer sections {
    .collection-section {
      display: grid;
      gap: var(--space-4);
      padding: var(--space-5) var(--storefront-inline-margin) var(--section-space);
      border-block-end: 2px solid var(--color-border);
      overflow-wrap: anywhere;
    }

    .collection-header {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: var(--space-2) var(--storefront-inline-padding);
      background: var(--color-yellow);
      border: 2px dashed var(--color-border);
    }

    .collection-header::before {
      content: '';
      position: absolute;
      inset: -10px;
      background: var(--print-gradient);
      filter: blur(var(--print-gradient-blur));
      z-index: -1;
      pointer-events: none;
    }

    .collection-title {
      font-size: 2rem;
    }

    .collection-description {
      padding-inline: var(--storefront-inline-padding);
    }

    .collection-products {
      display: grid;
      gap: var(--space-2);
      grid-template-columns: minmax(0, 1fr);
    }

    .collection-product {
      display: grid;
      grid-template-rows: auto 1fr;
      border: 2px dashed var(--color-border);
      background: var(--color-background);
    }

    .collection-product__title {
      font-size: 1.5rem;
    }

    .collection-product__media {
      display: block;
      aspect-ratio: 1;
      background: var(--color-accent-2);
    }

    .collection-product:nth-child(even) .collection-product__media {
      background: var(--color-accent);
    }

    .collection-product__content {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-block-start: 2px dashed var(--color-border);
      padding: var(--space-2);
    }

    .collection-product__content h2 {
      font-size: var(--text-heading);
    }

    .collection-product__status {
      /* padding: var(--space-1) var(--space-2); */
      background: var(--color-yellow);
    }

    .collection-product__media:focus-visible {
      outline-offset: -4px;
      outline-color: var(--color-border);
    }

    .collection-products > nav,
    .collection-products__empty {
      grid-column: 1 / -1;
    }

    .collection-products__empty {
      padding: var(--space-5);
      border: 2px dashed var(--color-border);
      background: var(--color-yellow);
    }

    @media (min-width: 24rem) {
      .collection-products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 64rem) {
      .collection-products {
        gap: var(--space-4);
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}

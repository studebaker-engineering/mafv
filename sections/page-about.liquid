{% assign hero_image = section.settings.hero_image %}

<article class="about-page">
  <h1>{{ page.title | escape }}</h1>

  {% if hero_image != blank %}
    {{
      hero_image
      | image_url: width: 2400
      | image_tag:
        class: 'about-page__hero',
        widths: '400, 640, 960, 1200, 1600, 2000, 2400',
        sizes: '(min-width: 80rem) 74rem, 92vw'
    }}
  {% endif %}

  {% if page.content != blank %}
    <div class="about-page__story rte">{{ page.content }}</div>
  {% endif %}
</article>

{% stylesheet %}
  @layer sections {
    .about-page {
      display: grid;
      justify-items: center;
      gap: clamp(var(--space-6), 5vw, var(--space-8));
      overflow-wrap: anywhere;
    }

    .about-page > h1 {
      max-width: 24ch;
      text-align: center;
    }

    .about-page__hero {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    .about-page__story {
      width: min(100%, var(--reading-width));
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "t:labels.hero_image"
    }
  ]
}
{% endschema %}
